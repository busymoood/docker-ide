# Shared config: symlinked on macOS, baked into the devbox image.
export ZSH="$HOME/.oh-my-zsh"
ZSH_THEME="robbyrussell"

ENABLE_CORRECTION="true"
COMPLETION_WAITING_DOTS="true"

plugins=(git zsh-autosuggestions zsh-syntax-highlighting)

# In the image: keep history on the persisted ~/.local volume.
if [[ -n "${DEVBOX_CONTAINER:-}" ]]; then
  HISTFILE="${HOME}/.local/share/zsh/history"
  mkdir -p "${HISTFILE:h}" 2>/dev/null || true
else
  HISTFILE="${HOME}/.zsh_history"
fi
HISTSIZE=10000
SAVEHIST=10000
HIST_STAMPS="yyyy-mm-dd"
setopt SHARE_HISTORY HIST_IGNORE_ALL_DUPS HIST_FIND_NO_DUPS HIST_REDUCE_BLANKS

# Oh My Zsh must never self-update inside the image (baked config layer).
if [[ -n "${DEVBOX_CONTAINER:-}" ]]; then
  zstyle ':omz:update' mode disabled
fi

zstyle ':completion:*' menu select
zstyle ':completion:*' matcher-list 'm:{a-zA-Z}={A-Za-z}'
if [[ -n "${LS_COLORS:-}" ]]; then
  zstyle ':completion:*' list-colors "${(s.:.)LS_COLORS}"
fi

# OMZ initializes compinit itself — no manual call needed here.
source "$ZSH/oh-my-zsh.sh"

# macOS only: Bitwarden's agent. Never override the socket injected by
# Docker (-e / containerEnv) or recreated by devbox-agent-relay.
if [[ -z "${DEVBOX_CONTAINER:-}" && -S "$HOME/.bitwarden-ssh-agent.sock" ]]; then
  export SSH_AUTH_SOCK="$HOME/.bitwarden-ssh-agent.sock"
fi

export EDITOR=nvim
export VISUAL="$EDITOR"
ZSH_AUTOSUGGEST_HIGHLIGHT_STYLE="fg=8"

# Only offer to edit ~/.zshrc when it is actually writable.
if [[ -w "$HOME/.zshrc" ]]; then
  alias zshconfig="nvim ~/.zshrc"
fi
if [[ -n "${DEVBOX_CONTAINER:-}" ]]; then
  alias dotfiles="cd /opt/devbox-config"
elif [[ -d "$HOME/dotfiles" ]]; then
  alias dotfiles="cd ~/dotfiles"
fi
alias reload="exec zsh"
