#!/usr/bin/env bash
# devbox-agent-relay — makes the host SSH agent available inside the container.
#
# Three cases:
#   • Native Docker (VPS, Raspberry Pi, native WSL2): the host Unix socket is
#     mounted as-is (SSH_AUTH_SOCK=/ssh-agent) → nothing to do; `start` only checks.
#   • Docker Desktop (macOS, Windows/WSL2 with integration): a non-Docker Unix
#     socket cannot be mounted → the host exposes the agent over TCP via socat
#     (launchd `com.busymoood.socat-ssh-agent` on 4242) and this program
#     recreates the local socket inside the container.
#   • Muted agent (Bitwarden locked): no socket can work — `start` warns and
#     arms a retry that replays `onstart` as soon as keys appear.
#
# Usage: devbox-agent-relay [start|doctor|stop|retry]
# Variables:
#   SSH_AUTH_SOCK              target socket inside the container (/tmp/ssh-agent.sock)
#   DEVBOX_SSH_RELAY_TARGET    host TCP target (host.docker.internal:4242)
#   DEVBOX_AGENT_RETRY_MIN     retry window in minutes (10, 0 = off)
set -euo pipefail

SOCK="${SSH_AUTH_SOCK:-/tmp/ssh-agent.sock}"
TARGET="${DEVBOX_SSH_RELAY_TARGET:-host.docker.internal:4242}"
RETRY_MIN="${DEVBOX_AGENT_RETRY_MIN:-10}"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
SOCAT_LOG="${LOG_DIR}/devbox-agent-relay.log"
RETRY_LOG="${LOG_DIR}/devbox-agent-retry.log"

log()  { printf '\033[1;34m[relay]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[relay][warning]\033[0m %s\n' "$*" >&2; }

agent_ok() { ssh-add -l >/dev/null 2>&1; }

# PID of the process listening on the socket (via `ss`, not `pgrep -f`: a
# command-line pattern can match a transient shell).
relay_pid() {
  ss -lxp 2>/dev/null \
    | grep -F "users:" \
    | grep -F "$SOCK" \
    | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' \
    | head -1 || true
}

start() {
  if [[ -S "$SOCK" ]] && agent_ok; then
    log "SSH agent already available (${SOCK}) — direct mount, nothing to do"
    return 0
  fi

  # Socket provided by a mount (native Linux): it cannot be replaced. The
  # agent is simply muted on the host side (Bitwarden locked?).
  if [[ -e "$SOCK" ]] && ! rm -f "$SOCK" 2>/dev/null; then
    warn "socket ${SOCK} is mounted from the host but the agent does not respond."
    warn "Unlock the agent (Bitwarden / ssh-agent) on the host, then retry."
    return 1
  fi

  command -v socat >/dev/null 2>&1 || { warn "socat is missing from the image."; return 1; }
  mkdir -p "$LOG_DIR"
  rm -f "$SOCK"

  # setsid: detached session. A plain `nohup … &` dies with the postStartCommand
  # session (agent OK at boot, dead in later shells).
  setsid nohup socat "UNIX-LISTEN:${SOCK},fork" "TCP:${TARGET}" \
    >>"$SOCAT_LOG" 2>&1 </dev/null &

  local i
  for i in $(seq 1 25); do
    [[ -S "$SOCK" ]] && break
    sleep 0.2
  done

  if [[ -S "$SOCK" ]]; then
    log "TCP relay active (${SOCK} → ${TARGET})"
  else
    warn "relay did NOT start — see ${SOCAT_LOG}"
    return 1
  fi

  if agent_ok; then
    log "SSH agent working ($(ssh-add -l | wc -l | tr -d ' ') key(s))"
    return 0
  fi

  warn "muted agent (Bitwarden locked? host relay stopped?)"
  warn "unlock it then: devbox-agent-relay start   ·   diagnose: devbox-agent-relay doctor"
  schedule_retry
  return 1
}

schedule_retry() {
  [[ "$RETRY_MIN" -gt 0 ]] || return 0
  pgrep -f "devbox-agent-relay retry" >/dev/null 2>&1 && return 0
  mkdir -p "$LOG_DIR"
  setsid nohup bash "$0" retry >>"$RETRY_LOG" 2>&1 </dev/null &
}

# Retry: replay `onstart` as soon as the agent responds (the user unlocked
# Bitwarden after the container started).
retry() {
  local interval=30
  local attempts=$(( RETRY_MIN * 60 / interval ))
  local i
  for ((i = 1; i <= attempts; i++)); do
    sleep "$interval"
    if agent_ok; then
      log "agent detected after $((i * interval)) s — resuming bootstrap"
      onstart --no-shell
      return 0
    fi
  done
  warn "agent still absent after ${RETRY_MIN} min — retry stopped."
  return 1
}

doctor() {
  local pid
  pid="$(relay_pid)"
  echo "== SSH agent"
  printf '  %-10s %s\n' "socket" "${SOCK} $([[ -S "$SOCK" ]] && echo '(present)' || echo '(ABSENT)')"
  printf '  %-10s %s\n' "target" "${TARGET}"
  printf '  %-10s %s\n' "socat" "${pid:-ABSENT}"
  printf '  %-10s %s\n' "log" "${SOCAT_LOG}"
  if agent_ok; then
    printf '  %-10s %s\n' "keys" "$(ssh-add -l | wc -l | tr -d ' ')"
    ssh-add -l | sed 's/^/    /'
  else
    printf '  %-10s %s\n' "keys" "NONE — muted agent"
    echo "  → unlock Bitwarden (or the agent) on the host, then: devbox-agent-relay start"
    echo "  → host (Docker Desktop): lsof -iTCP:4242 -sTCP:LISTEN"
  fi
  echo "== configs"
  printf '  %-10s %s\n' "nvim" "$(git -C "$HOME/.config/nvim" log --oneline -1 2>/dev/null || echo ABSENT)"
  printf '  %-10s %s\n' "dotfiles" "$([[ -d "$HOME/dotfiles" ]] && echo present || echo ABSENT)"
  printf '  %-10s %s\n' "supermaven" "$(readlink "$HOME/.supermaven" 2>/dev/null || echo ABSENT)"
}

stop() {
  local pid
  pid="$(relay_pid)"
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    log "relay stopped (pid ${pid})"
  fi
  rm -f "$SOCK"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  doctor) doctor ;;
  retry) retry ;;
  *)
    echo "usage: devbox-agent-relay [start|doctor|stop|retry]" >&2
    exit 2
    ;;
esac
