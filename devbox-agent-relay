#!/usr/bin/env bash
# devbox-agent-relay — rend l'agent SSH de l'hôte disponible dans le conteneur.
#
# Trois cas de figure :
#   • Docker natif (VPS, Raspberry Pi, WSL2 « docker natif ») : le socket Unix
#     de l'hôte est monté tel quel (SSH_AUTH_SOCK=/ssh-agent) → rien à faire,
#     `start` ne fait que vérifier.
#   • Docker Desktop (macOS, Windows/WSL2 avec intégration) : impossible de
#     monter un socket Unix non-docker → l'hôte expose l'agent en TCP via socat
#     (launchd `com.busymoood.socat-ssh-agent` sur 4242) et ce programme recrée
#     le socket local dans le conteneur.
#   • Agent muet (Bitwarden verrouillé) : aucun socket ne peut fonctionner —
#     `start` prévient et arme un rattrapage qui rejoue `onstart` dès que des
#     clés apparaissent.
#
# Usage : devbox-agent-relay [start|doctor|stop|retry]
# Variables :
#   SSH_AUTH_SOCK              socket cible dans le conteneur (/tmp/ssh-agent.sock)
#   DEVBOX_SSH_RELAY_TARGET    cible TCP de l'hôte (host.docker.internal:4242)
#   DEVBOX_AGENT_RETRY_MIN     durée du rattrapage en minutes (10, 0 = off)
set -euo pipefail

SOCK="${SSH_AUTH_SOCK:-/tmp/ssh-agent.sock}"
TARGET="${DEVBOX_SSH_RELAY_TARGET:-host.docker.internal:4242}"
RETRY_MIN="${DEVBOX_AGENT_RETRY_MIN:-10}"
LOG_DIR="${XDG_CACHE_HOME:-$HOME/.cache}"
SOCAT_LOG="${LOG_DIR}/devbox-agent-relay.log"
RETRY_LOG="${LOG_DIR}/devbox-agent-retry.log"

log()  { printf '\033[1;34m[relay]\033[0m %s\n' "$*"; }
warn() { printf '\033[1;33m[relay][attention]\033[0m %s\n' "$*" >&2; }

agent_ok() { ssh-add -l >/dev/null 2>&1; }

# PID du processus qui écoute sur le socket (via `ss`, pas `pgrep -f` : un
# motif de ligne de commande peut matcher un shell transitoire).
relay_pid() {
  ss -lxp 2>/dev/null \
    | grep -F "users:" \
    | grep -F "$SOCK" \
    | sed -n 's/.*pid=\([0-9][0-9]*\).*/\1/p' \
    | head -1
}

start() {
  if [[ -S "$SOCK" ]] && agent_ok; then
    log "agent SSH déjà disponible (${SOCK}) — montage direct, rien à faire"
    return 0
  fi

  # Socket déjà fourni par un montage (Linux natif) : on ne peut pas le
  # remplacer. L'agent est juste muet côté hôte (Bitwarden verrouillé ?).
  if [[ -e "$SOCK" ]] && ! rm -f "$SOCK" 2>/dev/null; then
    warn "socket ${SOCK} monté depuis l'hôte mais l'agent ne répond pas."
    warn "Déverrouille l'agent (Bitwarden / ssh-agent) côté hôte puis relance."
    return 1
  fi

  command -v socat >/dev/null 2>&1 || { warn "socat absent de l'image."; return 1; }
  mkdir -p "$LOG_DIR"
  rm -f "$SOCK"

  # setsid : session détachée. Un simple `nohup … &` meurt avec la session du
  # postStartCommand (agent OK au boot, mort dans les shells suivants).
  setsid nohup socat "UNIX-LISTEN:${SOCK},fork" "TCP:${TARGET}" \
    >>"$SOCAT_LOG" 2>&1 </dev/null &

  local i
  for i in $(seq 1 25); do
    [[ -S "$SOCK" ]] && break
    sleep 0.2
  done

  if [[ -S "$SOCK" ]]; then
    log "relais TCP actif (${SOCK} → ${TARGET})"
  else
    warn "relais NON démarré — voir ${SOCAT_LOG}"
    return 1
  fi

  if agent_ok; then
    log "agent SSH opérationnel ($(ssh-add -l | wc -l | tr -d ' ') clé(s))"
    return 0
  fi

  warn "agent muet (Bitwarden verrouillé ? relais hôte arrêté ?)"
  warn "déverrouille puis : devbox-agent-relay start   ·   diagnostic : devbox-agent-relay doctor"
  schedule_retry
  return 1
}

schedule_retry() {
  [[ "$RETRY_MIN" -gt 0 ]] || return 0
  pgrep -f "devbox-agent-relay retry" >/dev/null 2>&1 && return 0
  mkdir -p "$LOG_DIR"
  setsid nohup bash "$0" retry >>"$RETRY_LOG" 2>&1 </dev/null &
}

# Rattrapage : rejoue `onstart` dès que l'agent répond (l'utilisateur a
# déverrouillé Bitwarden après le démarrage du conteneur).
retry() {
  local interval=30
  local attempts=$(( RETRY_MIN * 60 / interval ))
  local i
  for ((i = 1; i <= attempts; i++)); do
    sleep "$interval"
    if agent_ok; then
      log "agent détecté après $((i * interval)) s — reprise du bootstrap"
      onstart --no-shell
      return 0
    fi
  done
  warn "agent toujours absent après ${RETRY_MIN} min — rattrapage arrêté."
  return 1
}

doctor() {
  local pid
  pid="$(relay_pid)"
  echo "== agent SSH"
  printf '  %-10s %s\n' "socket" "${SOCK} $([[ -S "$SOCK" ]] && echo '(présent)' || echo '(ABSENT)')"
  printf '  %-10s %s\n' "cible" "${TARGET}"
  printf '  %-10s %s\n' "socat" "${pid:-ABSENT}"
  printf '  %-10s %s\n' "log" "${SOCAT_LOG}"
  if agent_ok; then
    printf '  %-10s %s\n' "clés" "$(ssh-add -l | wc -l | tr -d ' ')"
    ssh-add -l | sed 's/^/    /'
  else
    printf '  %-10s %s\n' "clés" "AUCUNE — agent muet"
    echo "  → déverrouiller Bitwarden (ou l'agent) sur l'hôte, puis : devbox-agent-relay start"
    echo "  → hôte (Docker Desktop) : lsof -iTCP:4242 -sTCP:LISTEN"
  fi
  echo "== configs"
  printf '  %-10s %s\n' "nvim" "$(git -C "$HOME/.config/nvim" log --oneline -1 2>/dev/null || echo ABSENT)"
  printf '  %-10s %s\n' "dotfiles" "$([[ -d "$HOME/dotfiles" ]] && echo présents || echo ABSENTS)"
  printf '  %-10s %s\n' "supermaven" "$(readlink "$HOME/.supermaven" 2>/dev/null || echo ABSENT)"
}

stop() {
  local pid
  pid="$(relay_pid)"
  if [[ -n "$pid" ]]; then
    kill "$pid" 2>/dev/null || true
    log "relais arrêté (pid ${pid})"
  fi
  rm -f "$SOCK"
}

case "${1:-start}" in
  start) start ;;
  stop) stop ;;
  doctor) doctor ;;
  retry) retry ;;
  *)
    echo "usage: devbox-agent-relay [start|doctor|stop|retry]" >&2
    exit 2
    ;;
esac
